          { "ref": "M-0112" },
          { "ref": "M-0430" },
          { "ref": "M-0436" }
        ]
      },
      {
        "key": "open",
        "heading": "Open",
        "items": [
          {
            "text": "Fly.io or Railway for the v2 API is undecided. Ask before changing deploy config.",
            "cites": ["M-0431", "M-0174"]
          }
        ]
      }
    ]
