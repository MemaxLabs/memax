{
  "version": 1,
  "description": "V2 retrieval eval: kept statements of one project space, a second tenant's space for isolation, and graded queries (3 ideal, 2 highly relevant, 1 related, -1 harmful). Query types: lexical (shares words), paraphrase (shares few or no content words), typo, negative (nothing should match), isolation (only the other space holds the answer).",
  "synonyms": [
    ["river", "queue"],
    ["job", "task"],
    ["background", "async"],
    ["deploy", "ship"],
    ["api", "server"],
    ["postgres", "database"],
    ["secret", "credential"],
    ["string", "text"],
    ["colour", "color"]
  ],
  "memories": [
    { "id": "jobs-river", "space": "mine", "section": "decisions", "kind": "decision", "statement": "Background jobs run on River, not Temporal." },
    { "id": "jobs-idempotent", "space": "mine", "section": "conventions", "statement": "River jobs must be idempotent; a retry may run any job twice." },
    { "id": "deploy-fly", "space": "mine", "section": "decisions", "kind": "decision", "statement": "The API and the worker deploy to Fly.io in sjc." },
    { "id": "deploy-staging", "space": "mine", "section": "conventions", "statement": "Staging deploys on every merge to main; production deploys are manual." },
    { "id": "db-neon", "space": "mine", "section": "decisions", "kind": "decision", "statement": "Postgres runs on Neon, with point-in-time restore set to 7 days." },
    { "id": "migrations", "space": "mine", "section": "conventions", "statement": "Migrations are created with pnpm migrate:new, never numbered by hand." },
    { "id": "rls", "space": "mine", "section": "conventions", "statement": "Every V2 table has row-level security, enabled and forced." },
    { "id": "pnpm-only", "space": "mine", "section": "conventions", "statement": "Use pnpm workspaces; never npm or yarn in this repository." },
    { "id": "pnpm-catalog", "space": "mine", "section": "conventions", "statement": "Pin shared dependency versions with the pnpm catalog." },
    { "id": "web-next", "space": "mine", "section": "decisions", "kind": "decision", "statement": "The web app is Next.js 16 with the App Router." },
    { "id": "ledger-classes", "space": "mine", "section": "conventions", "statement": "Ledger components use mx- classes and design tokens, never Tailwind." },
    { "id": "colour-tokens", "space": "mine", "section": "conventions", "statement": "Colours are always tokens such as var(--seal), never literals." },
    { "id": "i18n", "space": "mine", "section": "conventions", "statement": "Every user-facing string goes through i18n, in English and Chinese." },
    { "id": "voyage", "space": "mine", "section": "decisions", "kind": "decision", "statement": "Embeddings come from Voyage: voyage-4 for documents, voyage-4-lite for queries." },
    { "id": "recall-budget", "space": "mine", "section": "conventions", "statement": "Recall answers within 300 milliseconds at the 95th percentile." },
    { "id": "judge-flags", "space": "mine", "section": "conventions", "statement": "The judge flags a proposal that contradicts a decision in force." },
    { "id": "people-keep", "space": "mine", "section": "preferences", "statement": "Agents propose and people keep." },
    { "id": "small-prs", "space": "mine", "section": "preferences", "statement": "Ziyang prefers small pull requests with one change each." },
    { "id": "review-noon", "space": "mine", "section": "preferences", "statement": "Code review happens before noon on weekdays." },
    { "id": "release-thursday", "space": "mine", "section": "conventions", "statement": "Releases ship on Thursdays after the code freeze." },
    { "id": "secrets-doppler", "space": "mine", "section": "conventions", "statement": "Secrets live in Doppler, never in the repository." },
    { "id": "redis-upstash", "space": "mine", "section": "decisions", "kind": "decision", "statement": "Redis comes from Upstash, in the same region as the API." },
    { "id": "compile-internal", "space": "mine", "section": "decisions", "kind": "decision", "statement": "The compile service is internal-only on Fly's private network." },
    { "id": "format-lint", "space": "mine", "section": "conventions", "statement": "Run pnpm format and pnpm lint before every commit." },
    { "id": "api-envelope", "space": "mine", "section": "conventions", "statement": "Go handlers return model.ApiResponse; raw JSON is a bug." },
    { "id": "forget-purge", "space": "mine", "section": "conventions", "statement": "Forget purges the words, the embeddings and the search index in one transaction." },
    { "id": "cli-binary", "space": "mine", "section": "conventions", "statement": "The CLI binary is memax; install it with npx memax-cli init." },
    { "id": "error-messages", "space": "mine", "section": "conventions", "statement": "Error messages say what to do next, not only what went wrong." },
    { "id": "dark-mode", "space": "mine", "section": "preferences", "statement": "Dark mode is first-class; check both themes." },
    { "id": "r2", "space": "mine", "section": "decisions", "kind": "decision", "statement": "Object storage is Cloudflare R2." },
    { "id": "testdb", "space": "mine", "section": "conventions", "statement": "Tests that need a database clone a migrated template per test." },
    { "id": "mcp-versions", "space": "mine", "section": "conventions", "statement": "The MCP server speaks protocol 2026-07-28 and the 2025 versions." },
    { "id": "dream-cadence", "space": "mine", "section": "open_question", "statement": "Should Dream run nightly or on demand?" },
    { "id": "display-ids", "space": "mine", "section": "conventions", "statement": "Display IDs like M-0219 are counters per tenant." },
    { "id": "receipts-no-words", "space": "mine", "section": "conventions", "statement": "Receipts never hold a memory's words." },
    { "id": "rate-limits", "space": "mine", "section": "conventions", "statement": "Rate limits use a sliding window in Redis." },

    { "id": "other-sidekiq", "space": "theirs", "section": "decisions", "kind": "decision", "statement": "Background jobs run on Sidekiq, not River." },
    { "id": "other-lambda", "space": "theirs", "section": "decisions", "kind": "decision", "statement": "The API deploys to AWS Lambda in us-east-1." },
    { "id": "other-gke", "space": "theirs", "section": "decisions", "kind": "decision", "statement": "Kubernetes runs on GKE Autopilot." }
  ],
  "queries": [
    { "id": "lex-river", "type": "lexical", "query": "river jobs", "relevance": { "jobs-river": 3, "jobs-idempotent": 3, "other-sidekiq": -1 } },
    { "id": "lex-deploy", "type": "lexical", "query": "deploy to fly", "relevance": { "deploy-fly": 3, "deploy-staging": 2, "compile-internal": 1, "other-lambda": -1 } },
    { "id": "lex-catalog", "type": "lexical", "query": "pnpm catalog", "relevance": { "pnpm-catalog": 3, "pnpm-only": 1 } },
    { "id": "lex-rls", "type": "lexical", "query": "row-level security", "relevance": { "rls": 3 } },
    { "id": "lex-voyage", "type": "lexical", "query": "voyage embeddings", "relevance": { "voyage": 3, "forget-purge": 1 } },
    { "id": "lex-i18n", "type": "lexical", "query": "i18n strings", "relevance": { "i18n": 3 } },
    { "id": "lex-doppler", "type": "lexical", "query": "secrets in doppler", "relevance": { "secrets-doppler": 3 } },
    { "id": "lex-receipts", "type": "lexical", "query": "receipts memory words", "relevance": { "receipts-no-words": 3, "forget-purge": 1 } },

    { "id": "para-queue", "type": "paraphrase", "query": "Which queue handles async tasks?", "relevance": { "jobs-river": 3, "jobs-idempotent": 2, "other-sidekiq": -1 } },
    { "id": "para-ship", "type": "paraphrase", "query": "Where do the servers ship?", "relevance": { "deploy-fly": 3, "deploy-staging": 2, "other-lambda": -1 } },
    { "id": "para-db", "type": "paraphrase", "query": "Which database do we run, and how long are backups kept?", "relevance": { "db-neon": 3, "testdb": 1 } },
    { "id": "para-credentials", "type": "paraphrase", "query": "Where do credentials go?", "relevance": { "secrets-doppler": 3 } },
    { "id": "para-text", "type": "paraphrase", "query": "Must UI text be translated?", "relevance": { "i18n": 3 } },
    { "id": "para-color", "type": "paraphrase", "query": "Can I hardcode a color?", "relevance": { "colour-tokens": 3, "ledger-classes": 1 } },
    { "id": "para-tenancy", "type": "paraphrase", "query": "How is one space kept from reading another's tables?", "relevance": { "rls": 3 } },
    { "id": "para-latency", "type": "paraphrase", "query": "How fast must recall be?", "relevance": { "recall-budget": 3 } },

    { "id": "typo-idempotent", "type": "typo", "query": "idempotnet jobs", "relevance": { "jobs-idempotent": 3, "jobs-river": 1 } },
    { "id": "typo-cloudflare", "type": "typo", "query": "cloudflair storage", "relevance": { "r2": 3 } },
    { "id": "typo-upstash", "type": "typo", "query": "upstsh redis", "relevance": { "redis-upstash": 3, "rate-limits": 1 } },

    { "id": "neg-kubernetes", "type": "negative", "query": "kubernetes autoscaling", "relevance": { "other-gke": -1 } },
    { "id": "neg-pizza", "type": "negative", "query": "favourite pizza topping", "relevance": {} },
    { "id": "neg-revenue", "type": "negative", "query": "quarterly revenue forecast", "relevance": {} },

    { "id": "iso-sidekiq", "type": "isolation", "query": "Sidekiq", "relevance": { "jobs-river": 1, "other-sidekiq": -1 } },
    { "id": "iso-lambda", "type": "isolation", "query": "AWS Lambda us-east-1", "relevance": { "deploy-fly": 1, "other-lambda": -1 } }
  ]
}
