{
  "name": "@memaxlabs/compile-service",
  "version": "0.1.0",
  "private": true,
  "description": "The stateless compile service: @memaxlabs/compiler over HTTP on Memax's private network",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@memaxlabs/compiler": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
