    "title": "Memax V2 engineering brief",
    "summary": "What every agent on this project reads before it writes code.",
    "sections": [
      {
        "key": "overview",
        "heading": "What this is",
        "items": [
          {
            "text": "Memax V2 is the context layer every agent on the team reads from: a cited record of decisions and conventions that compiles into each tool's files and answers live over MCP.",
            "cites": ["M-0001"]
          },
          {
            "text": "Writes from agents go to Review unless the agent is trusted to write.",
            "cites": ["M-0012"]
          }
        ]
      },
      {
        "key": "decisions",
        "heading": "Decisions",
        "items": [
          { "ref": "M-0219" },
          { "ref": "M-0102" },
          { "ref": "M-0098" },
          { "ref": "M-0187" }
        ]
      },
      {
