# =============================================================================
# Memax Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, local Docker, etc.)
# Omit to use in-memory store (local dev quick start, no persistence).
DATABASE_URL=postgres://memax:memax@postgres:5432/memax?sslmode=disable

# Path to SQL migration files (default: auto-detected in dev, /migrations in Docker)
# MIGRATIONS_DIR=./migrations

# PostgreSQL migration session timeouts for the Fly release command.
# lock_timeout bounds waiting on advisory/schema locks.
# statement_timeout bounds a single SQL statement so long index builds fail clearly.
# connect_timeout bounds database connect/ping for the release machine.
# river_timeout bounds River's own schema migration step.
# MIGRATION_LOCK_TIMEOUT_MS=15000
# MIGRATION_STATEMENT_TIMEOUT_MS=240000
# MIGRATION_CONNECT_TIMEOUT_MS=30000
# MIGRATION_RIVER_TIMEOUT_MS=30000

# ── Server ───────────────────────────────────────────────────────────────────
# API server port (default: 8080)
# PORT=8080

# Worker health check port (default: 9090)
# HEALTH_PORT=9090

# Maximum request body size in bytes (default: 3145728 = 3MB)
# MAX_BODY_SIZE=3145728

# HMAC key for signing short-lived attachment view URLs used to render
# image attachments inline via <img src>. Unset = inline previews
# disabled; the authenticated download path still works. Use a random
# 32+ byte secret in production; `openssl rand -hex 32` is fine.
# ATTACHMENT_VIEW_SIGNING_KEY=

# Public API origin for MCP OAuth discovery and provider callback URLs.
# Required for remote MCP OAuth and OAuth login. Omit for local dev.
# API_BASE_URL=https://api.example.com

# Base URL for the web app (used to generate invite links).
# Example: https://memax.app or https://app.example.com
# APP_BASE_URL=http://localhost:3000

# Developer docs origin — auto-injected into email templates as {{ .DocsURL }}.
# Falls back to the prod default (https://docs.memax.app) when empty, so
# forgotten staging envs never produce broken email links.
# DOCS_BASE_URL=http://localhost:3001

# Environment name — controls debug output and analytics tagging.
# Values: dev, staging, production (default: dev)
# In dev mode: AI synthesis (/v1/ask) is enabled for all users by default.
# To test free-tier, use the mockFreePlan toggle in Settings > Account > Dev Tools.
# MEMAX_ENV=dev

# Optional override for the worker's identity in river_client (the
# admin ops Pulse page). Production sets FLY_MACHINE_ID automatically;
# set this only when you need a specific stable client id — e.g.,
# running multiple local worker processes against a shared dev DB and
# wanting them to appear as distinct rows. Defaults to
# FLY_MACHINE_ID → hostname-pid → generated sentinel.
# MEMAX_WORKER_CLIENT_ID=

# ── Authentication ───────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -hex 32
# CRITICAL: Change from default in any non-local deployment.
# JWT_SECRET=

# GitHub OAuth app credentials. Create at: https://github.com/settings/developers
# Required for `memax login` and web app authentication.
# Callback defaults to ${API_BASE_URL}/v1/auth/github/callback.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# Optional legacy override. Prefer API_BASE_URL unless a deployment needs a custom callback.
# OAUTH_GITHUB_REDIRECT_URL=

# Google OAuth client credentials. Callback: ${API_BASE_URL}/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional Google OAuth allowlist. Leave unset to allow any verified Google account.
# Useful for staging/private deployments. Either list exact emails, allowed domains, or both.
# OAUTH_GOOGLE_ALLOWED_EMAILS=alice@example.com,bob@example.com
# OAUTH_GOOGLE_ALLOWED_DOMAINS=example.com

# Restrict login to members of a GitHub organization (optional, for private deployments)
# OAUTH_GITHUB_REQUIRED_ORG=

# GitHub org whose members get dev_access flag (non-blocking, enables dev tools)
# DEV_GITHUB_ORG=

# Admin bearer token for protected endpoints (e.g., /v1/admin/reindex)
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# Comma-separated emails of users who should be granted super_admin on boot.
# Used to bootstrap the first admin before the admin dashboard exists.
# ADMIN_EMAILS=you@example.com

# Registration mode: open (anyone), invite_only (waitlist), org_gated (staging)
# REGISTRATION_MODE=open

# ── Email ────────────────────────────────────────────────────────────────────
# Transactional email (Resend). If unset, emails are logged to stdout (dev mode).
# RESEND_API_KEY=re_xxx

# From address for outbound emails (default: memax <noreply@memax.app>)
# EMAIL_FROM=memax <noreply@memax.app>

# SMTP fallback (used when RESEND_API_KEY is not set). Works with any SMTP server.
# Sender address is controlled by EMAIL_FROM above — not a separate SMTP_FROM.
# SMTP_HOST=smtp.example.com:587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Resend delivery webhook secret (Svix-signed). Required to process
# delivered/opened/bounced/complained events posted to /v1/webhooks/resend.
# When unset, campaign delivery stats only reflect enqueued/failed state.
# Grab from Resend dashboard → Webhooks → Signing secret (starts with whsec_).
# RESEND_WEBHOOK_SECRET=whsec_xxx

# ── Waitlist ─────────────────────────────────────────────────────────────────
# Global capacity cap per wave. Shown in admin dashboard gauge.
# Set to 0 or omit to disable the cap display.
# WAITLIST_WAVE_CAP=50

# ── AI Services ──────────────────────────────────────────────────────────────
# All optional — features degrade gracefully when keys are missing.
# No key = feature disabled (nil pattern, no errors).

# Anthropic API key — powers categorization, summarization, extraction,
# fact linking, config merge, answer synthesis, and Memory Dreams.
# ANTHROPIC_API_KEY=

# Anthropic-compatible gateway base URL (default: https://api.anthropic.com)
# Set to use OpenRouter, AWS Bedrock proxy, etc.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Voyage AI API key — powers vector embeddings for semantic search.
# Without this, recall falls back to keyword (pg_trgm) search only.
# VOYAGE_API_KEY=

# Redis (Upstash/local Redis) — used for retrieval caching and real-time pubsub notifications
# REDIS_URL=redis://localhost:6379
# Redis (Critical) - used for rate limit and usage counters
# REDIS_CRITICAL_URL=redis://localhost:6379

# Voyage AI model (default: voyage-code-3)
# VOYAGE_MODEL=voyage-code-3

# ── LLM Model Overrides ─────────────────────────────────────────────────────
# Each LLM-powered module reads its model from an env var, falling back to
# claude-haiku-4-5-20251001. Override individual modules for cost/quality tuning.

# CATEGORIZE_MODEL=claude-haiku-4-5        # Auto-classification (category + tags)
# SUMMARIZE_MODEL=claude-haiku-4-5         # 2-4 sentence memory summaries
# EXTRACT_MODEL=claude-haiku-4-5           # Fact extraction from transcripts
# LINK_MODEL=claude-haiku-4-5              # URL fetch + summarization
# FILEPROC_MODEL=claude-haiku-4-5          # File content processing
# FORMAT_MODEL=claude-haiku-4-5            # HTML/OCR cleanup into readable markdown
# FORMAT_TIMEOUT_MS=90000                  # Timeout budget for optional formatting cleanup LLM pass
# TITLE_MODEL=claude-haiku-4-5             # Smart title refinement for low-quality filenames
# DISTILL_MODEL=claude-haiku-4-5           # Query understanding before retrieval
# ASK_MODEL=claude-sonnet-4-6              # Answer synthesis default (see /v1/ask model=auto/sonnet)
# DREAMS_MODEL=claude-haiku-4-5            # Memory Dreams (merge, contradictions)
# DREAMS_ORGANIZE_MODEL=claude-sonnet-4-6  # Topic organization + restructure (stronger reasoning)
# MERGE_MODEL=claude-haiku-4-5             # Config merge (LLM-powered conflict resolution)

# Dream-tier quota enforcement mode. Default: soft (Phase 1 rollout —
# the gate runs but always allows; signal rows are written for
# capacity planning). Set to "hard" to flip on Phase 3 enforcement
# (402 on cap exhaustion). See docs/plans/23-dream-tiers.md.
# DREAM_QUOTA_MODE=soft

# Onboarding checklist restart rate limit (per user, rolling 24h).
# Counts every checklist row created — pending, resolved, dismissed,
# or expired — so a spam-restart loop trips even with auto-dismiss.
# Default 10. Set to 0 (or negative) to disable entirely. Staging
# typically runs higher (e.g. 50) so testing isn't rate-limited.
# ONBOARDING_RESTART_RATE_MAX=10

# ── Analytics (PostHog) ──────────────────────────────────────────────────────
# Server-side PostHog (optional — no analytics if omitted)
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://us.i.posthog.com

# Web app PostHog (same project, exposed to browser via NEXT_PUBLIC_ prefix)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Observability (OpenTelemetry / Grafana Cloud / Honeycomb) ───────────────
# Optional. If OTEL_EXPORTER_OTLP_ENDPOINT is set, the API server exports traces
# and metrics over OTLP HTTP. Instrumentation is currently focused on the recall
# pipeline and records per-stage latency.
#
# Grafana Cloud example:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(instance_id:api_token)>
#
# Defaults baked into the binaries:
# - API service.name = memax-api
# - Worker service.name = memax-worker
# - service.namespace = memax
# - deployment.environment = MEMAX_ENV (or dev if unset)
# - OTLP protocol = http/protobuf
#
# Optional overrides:
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=memax,service.version=git-sha
#
# Optional direct app -> Grafana Cloud Loki export. When LOKI_URL,
# LOKI_USERNAME, and LOKI_PASSWORD are set on memax-api / memax-worker, logs
# continue to go to stdout and are also exported asynchronously to Loki.
# LOKI_URL=https://logs-prod-021.grafana.net
# LOKI_USERNAME=<grafana_logs_instance_id>
# LOKI_PASSWORD=<grafana_cloud_access_policy_token>
# LOKI_QUEUE_SIZE=2048
# LOKI_BATCH_MAX_RECORDS=256
# LOKI_BATCH_MAX_BYTES=524288
# LOKI_BATCH_INTERVAL_MS=2000
# LOKI_REQUEST_TIMEOUT_MS=5000
# LOKI_MAX_RETRIES=3

# ── Web App (Next.js) ───────────────────────────────────────────────────────
# Per-surface origins. Default to production when unset so preview builds
# and forgotten-env deploys don't serve localhost links to users — never
# fallback to localhost here (see packages/web/src/lib/urls.ts).
# API server URL for the frontend (default prod: https://api.memax.app)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Web app origin — used for share links, OAuth redirects (default prod: https://memax.app)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Developer docs origin — footer links, changelog (default prod: https://docs.memax.app)
# NEXT_PUBLIC_DOCS_URL=http://localhost:3001

# ── CLI ──────────────────────────────────────────────────────────────────────
# These are read by memax-cli, not the server. Set in your shell profile.

# API key for non-interactive/CI environments (skips `memax login`)
# MEMAX_API_KEY=mk_xxx

# Override API URL (default: from ~/.memax/config.json)
# MEMAX_API_URL=https://api.example.com

# ── Object Storage (S3-compatible: MinIO local, Cloudflare R2 in prod) ──────
# Used for preserved original memory uploads and large presigned file uploads.
# If unset, memory attachments/original file preservation is disabled.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=memax
# S3_SECRET_KEY=memaxdevpass
# S3_BUCKET=memax-storage
# S3_REGION=us-east-1
#
# ── Public-read base URL ───────────────────────────────────────────────────
# Used by admin seed-image uploads (and other public-by-design assets) to
# return a stable public URL after PUT. This is the bucket's anonymous-
# downloadable hostname/prefix. NOT the same as S3_PUBLIC_ENDPOINT, which
# is only for browser-reachable presigned PUT URLs.
#
# Local MinIO setup (one-time, after `docker compose up`):
#   mc alias set local http://localhost:9000 memax memaxdevpass
#   mc anonymous set download local/memax-storage/public
# Then set:
#   R2_PUBLIC_BASE_URL=http://localhost:9000/memax-storage
#
# Cloudflare R2: configure a public.r2.dev domain (or custom domain) on
# the bucket, scoped to the `public/*` prefix. Set the resulting URL.
# Example: R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
#
# If unset, /v1/admin/seed-images/upload returns 503 uploads_unavailable.
# R2_PUBLIC_BASE_URL=

# ── Future (designed, not yet implemented) ───────────────────────────────────
# These are documented in design docs but not yet read by any code.

# Cohere Rerank — selective second-stage reranking for ambiguous recall results.
# COHERE_API_KEY=
# RERANK_MODEL=rerank-v4.0-fast
# RERANK_TOP_N=15
# RERANK_TIMEOUT_MS=1000
# RERANK_CACHE_TTL_SECONDS=900

# Exact-match recall cache for fresh query reuse across /v1/recall and /v1/ask.
# Short TTL avoids stale retrieval after recent pushes while still letting ask reuse recall.
# RECALL_CACHE_TTL_SECONDS=60

# Exact-match non-streaming ask cache.
# Keyed by owner/query/model/locale/context and reused only for identical ask requests.
# ASK_CACHE_TTL_SECONDS=900

# AI Ask context controls. Defaults use more of modern Claude context windows
# while preserving retrieval precision, latency, and cost headroom.
# ASK_DEFAULT_SOURCES=10
# ASK_MAX_SOURCES=120
# ASK_MAX_OUTPUT_TOKENS=2048
# ASK_SOURCE_MAX_TOKENS=25000
# ASK_SONNET_CONTEXT_BUDGET_TOKENS=500000
# ASK_HAIKU_CONTEXT_BUDGET_TOKENS=120000
# ASK_CONTEXT_BUDGET_TOKENS=        # Optional global override for both models
