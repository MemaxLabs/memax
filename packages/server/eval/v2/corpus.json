{
  "version": 2,
  "description": "V2 retrieval eval: kept statements of one project space, a second tenant's space for isolation, and graded queries (3 ideal, 2 highly relevant, 1 related, -1 harmful). Query types: lexical (shares words), paraphrase (shares few or no content words), typo, negative (nothing should match), isolation (only the other space holds the answer). Version 2 (Oct 6, 2026) grew it from 39 statements and 24 queries to 118 and 66, in the same style, so the live run could calibrate the vector floor on more than three negative queries and exercise the reranker (which needs more than 8 candidates).",
  "synonyms": [
    ["river", "queue"],
    ["job", "task"],
    ["background", "async"],
    ["deploy", "ship"],
    ["api", "server"],
    ["postgres", "database"],
    ["secret", "credential"],
    ["string", "text"],
    ["colour", "color"]
  ],
